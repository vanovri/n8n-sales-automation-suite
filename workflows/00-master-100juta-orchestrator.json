      "name": "Prepare Master Revenue Router",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function route(raw) {\n  const map = { 'lead.captured': 1, 'wa.greeting': 2, 'lead.qualify': 3, 'form.submit': 4, 'dm.inbound': 5, 'meeting.book': 6, 'lead.hot': 7, 'quote.create': 8, 'proposal.send': 9, 'proposal.summarize': 10, 'leads.followup': 11, 'proposals.followup': 12, 'leads.reengage': 13, 'invoice.create': 14, 'payment.settled': 15, 'client.onboard': 16, 'review.submit': 17, 'clients.upsell': 18, 'competitors.check': 19, 'sales.report': 20 };\n  const target = map[raw.event_type];\n  if (!target) throw new Error('Unsupported event_type');\n  return { ...raw.payload, target_workflow_id: 'revenue' + String(target).padStart(2, '0') };\n}\nreturn $input.all().flatMap((item, i) => { const d = item.json.body ?? item.json; const out = route(d); return out ? [{json:out,pairedItem:{item:i}}] : []; });"
      }
    },
    {
      "id": "0975c0cc-a586-4f4f-b3a1-15541c2754bc",
      "name": "Execute target",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        930,
        400
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "={{ $json.target_workflow_id }}",
          "mode": "id"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "aec6a558-e900-48d8-8993-d55cce5b8f3c",
      "name": "Restore Execute target",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nreturn $input.all().map((item,i)=>({json:$(\"Prepare Master Revenue Router\").itemMatching(i).json,pairedItem:{item:i}}));"
      }
    },
    {

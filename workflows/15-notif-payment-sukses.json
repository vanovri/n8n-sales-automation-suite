      "position": [
        930,
        400
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ \"https://api.sandbox.midtrans.com\"+'/v2/'+encodeURIComponent($json.invoice_no)+'/status' }}",
        "options": {

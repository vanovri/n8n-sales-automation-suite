      "name": "Prepare Notif Payment Sukses",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function paymentRequest(raw) {\n  const order = String(need(raw.order_id, 'order_id'));\n  if (!/^[A-Za-z0-9_-]{1,64}$/.test(order)) throw new Error('Invalid order_id');\n  return { invoice_no: order };\n}\nfunction need(value, name) {\n  if (value === undefined || value === null || String(value).trim() === '') throw new Error('Required: ' + name);\n  return value;\n}\nreturn $input.all().flatMap((item, i) => { const d = item.json.body ?? item.json; const out = paymentRequest(d); return out ? [{json:out,pairedItem:{item:i}}] : []; });"
      }
    },

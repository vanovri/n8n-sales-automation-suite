      "name": "Reject occupied slot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function available(d, events) {\n  if (events.some(e => e.id && e.status !== 'cancelled' && e.transparency !== 'transparent')) throw new Error('Calendar conflict. Choose another slot.');\n  return d;\n}\nreturn [{json:available($(\"Prepare Auto Booking Meeting\").first().json,$input.all().map(i=>i.json))}];"
      }
    },

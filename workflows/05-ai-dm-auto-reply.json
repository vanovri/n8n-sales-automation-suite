        3000,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function dmReply(d, result) { return { ...d, reply_text: String(need(aiJSON(result).reply_text, 'reply_text')).slice(0, 3500) }; }\nfunction need(value, name) {\n  if (value === undefined || value === null || String(value).trim() === '') throw new Error('Required: ' + name);\n  return value;\n}\nfunction aiJSON(result) {\n  const raw = result.output || result.text;\n  if (raw && typeof raw === 'object') return raw;\n  try { return JSON.parse(String(need(raw, 'AI response')).replace(/^```(?:json)?\\s*|\\s*```$/g, '').trim()); }\n  catch { throw new Error('AI response must contain valid JSON'); }\n}\nreturn $input.all().flatMap((item, i) => { const d = item.json.body ?? item.json; const out = dmReply($(\"Restore Save Leads_DB 8\").itemMatching(i).json, d); return out ? [{json:out,pairedItem:{item:i}}] : []; });"
      }

    {
      "id": "7fd48779-b023-4b57-b618-4a700f2f07dd",
      "name": "Use provider payment link",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function invoiceLink(d, result) { return { ...d, payment_url: url(result.redirect_url, 'provider payment URL'), payment_expires_at:new Date(Date.now()+24*3600000).toISOString() }; }\nfunction url(value, name) {\n  const s = String(need(value, name));\n  if (!/^https:\\/\\/[^\\s<>\"']+$/i.test(s)) throw new Error('Invalid HTTPS URL: ' + name);\n  return s;\n}\nfunction need(value, name) {\n  if (value === undefined || value === null || String(value).trim() === '') throw new Error('Required: ' + name);\n  return value;\n}\nreturn $input.all().flatMap((item, i) => { const d = item.json.body ?? item.json; const out = invoiceLink($(\"Prepare Invoice dan Reminder\").itemMatching(i).json,d); return out ? [{json:out,pairedItem:{item:i}}] : []; });"
      }
    },

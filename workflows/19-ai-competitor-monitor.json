    {
      "id": "71b2356e-1d26-410c-8c5e-15156d65ac23",
      "name": "Parse Gemini result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1620,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function intel(d, result) { return { ...d, summary: String(need(aiJSON(result).summary, 'competitor summary')), message: `${d.competitor_name}\\n${String(need(aiJSON(result).summary, 'summary'))}\\nSumber: ${d.pricing_url}` }; }\nfunction need(value, name) {\n  if (value === undefined || value === null || String(value).trim() === '') throw new Error('Required: ' + name);\n  return value;\n}\nfunction aiJSON(result) {\n  const raw = result.output || result.text;\n  if (raw && typeof raw === 'object') return raw;\n  try { return JSON.parse(String(need(raw, 'AI response')).replace(/^```(?:json)?\\s*|\\s*```$/g, '').trim()); }\n  catch { throw new Error('AI response must contain valid JSON'); }\n}\nreturn $input.all().flatMap((item, i) => { const d = item.json.body ?? item.json; const out = intel($(\"Extract actual snapshot\").itemMatching(i).json, d); return out ? [{json:out,pairedItem:{item:i}}] : []; });"
      }
    },
